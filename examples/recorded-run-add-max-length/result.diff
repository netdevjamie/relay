 """Turn a title into a URL slug: "Hello, World!" becomes "hello-world"."""
 
+import argparse
 import re
 import sys
 import unicodedata
 
+CAP_RULE = "must be a whole number of at least 1, at most 20 characters long"
+LONGEST_CAP_TEXT = 20
+CAP_FLAG = "--max-length"
 
-def slugify(text: str) -> str:
-    """Lower-case ASCII words joined by single hyphens."""
+
+def slugify(text: str, max_length: int | None = None) -> str:
+    """Lower-case ASCII words joined by single hyphens.
+
+    With max_length, the slug is cut to at most that many characters,
+    between words where it can be, and never ends with a hyphen.
+    """
+    if max_length is not None and max_length < 1:
+        raise ValueError(f"max_length must be at least 1, got {max_length}")
     ascii_text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
     words = re.findall(r"[a-z0-9]+", ascii_text.lower())
-    return "-".join(words)
+    slug = "-".join(words)
+    if max_length is None:
+        return slug
+    return cut_at_word_boundary(slug, max_length)
+
+
+def cut_at_word_boundary(slug: str, max_length: int) -> str:
+    """Shorten a slug to max_length characters, keeping whole words if any fit."""
+    if len(slug) <= max_length:
+        return slug
+    kept = slug[:max_length]
+    character_after_cut = slug[max_length:max_length + 1]
+    if character_after_cut == "-":
+        return kept
+    last_hyphen = kept.rfind("-")
+    if last_hyphen == -1:
+        return kept
+    return kept[:last_hyphen]
+
+
+def whole_number_of_at_least_one(value: str) -> int:
+    """argparse type for --max-length: refuse anything but an integer >= 1.
+
+    The text-length check keeps the refusal the same on every Python
+    version, rather than relying on int()'s digit limit in 3.11 and later.
+    """
+    if len(value) > LONGEST_CAP_TEXT:
+        raise argparse.ArgumentTypeError(CAP_RULE)
+    try:
+        number = int(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(CAP_RULE) from None
+    if number < 1:
+        raise argparse.ArgumentTypeError(CAP_RULE)
+    return number
+
+
+def build_parser() -> argparse.ArgumentParser:
+    """No -h/--help: those are titles, like any argument but --max-length."""
+    parser = argparse.ArgumentParser(
+        prog="python3 slugify.py",
+        allow_abbrev=False,
+        add_help=False,
+    )
+    parser.add_argument(
+        CAP_FLAG,
+        type=whole_number_of_at_least_one,
+        action="append",
+        metavar="N",
+    )
+    parser.add_argument("title", metavar='"Some Title"')
+    return parser
+
+
+def separate_titles(argv: list[str]) -> list[str]:
+    """Put every argument except --max-length and its value after "--".
+
+    --max-length is the only option, so any other argument is the title,
+    even one that starts with a hyphen ("-x", "--help", "--"), as it was
+    before the flag existed. Its value is left for argparse to check.
+    """
+    options = []
+    titles = []
+    position = 0
+    while position < len(argv):
+        argument = argv[position]
+        if argument == CAP_FLAG:
+            options.extend(argv[position:position + 2])
+            position += 2
+            continue
+        if argument.startswith(CAP_FLAG + "="):
+            options.append(argument)
+        else:
+            titles.append(argument)
+        position += 1
+    return [*options, "--", *titles]
 
 
 def main(argv: list[str]) -> int:
-    if len(argv) != 1:
-        print('usage: python3 slugify.py "Some Title"', file=sys.stderr)
-        return 2
-    print(slugify(argv[0]))
+    """Print the slug of one title. Bad arguments exit with code 2 via argparse."""
+    parser = build_parser()
+    arguments = parser.parse_args(separate_titles(argv))
+    caps = arguments.max_length or []
+    if len(caps) > 1:
+        parser.error(f"argument {CAP_FLAG}: may be given only once")
+    max_length = caps[0] if caps else None
+    print(slugify(arguments.title, max_length=max_length))
     return 0
 
 
