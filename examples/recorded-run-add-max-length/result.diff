+import shlex
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
 from slugify import main, slugify
 
+SCRIPT = Path(__file__).with_name("slugify.py")
+FOX = "The Quick Brown Fox"
+
 
 def test_words_are_lower_cased_and_joined_by_hyphens():
     assert slugify("Hello, World!") == "hello-world"
@@ -20,3 +30,266 @@ def test_nothing_sluggable_gives_an_empty_slug():
 def test_cli_prints_the_slug(capsys):
     assert main(["Ship It"]) == 0
     assert capsys.readouterr().out == "ship-it\n"
+
+
+# --- max_length in code -------------------------------------------------
+
+def run_script(*arguments):
+    return subprocess.run(
+        [sys.executable, str(SCRIPT), *arguments],
+        capture_output=True,
+        text=True,
+    )
+
+
+def test_no_cap_leaves_a_long_slug_whole():
+    long_title = " ".join(["word"] * 50)
+    assert slugify(long_title) == "-".join(["word"] * 50)
+    assert slugify(long_title, max_length=None) == "-".join(["word"] * 50)
+
+
+@pytest.mark.parametrize(
+    "title, cap, expected",
+    [
+        (FOX, 19, "the-quick-brown-fox"),
+        (FOX, 100, "the-quick-brown-fox"),
+        (FOX, 12, "the-quick"),
+        (FOX, 10, "the-quick"),
+        (FOX, 9, "the-quick"),
+        (FOX, 3, "the"),
+        (FOX, 2, "th"),
+        ("Supercalifragilistic", 5, "super"),
+        ("Hello, World!", 1, "h"),
+        ("!!!", 5, ""),
+        ("a-supercalifragilistic", 10, "a"),
+    ],
+)
+def test_capped_slug_matches_the_cutting_rule_and_fits(title, cap, expected):
+    result = slugify(title, max_length=cap)
+    assert result == expected
+    assert len(result) <= cap
+    assert not result.endswith("-")
+    assert not result.startswith("-")
+
+
+@pytest.mark.parametrize("cap", [12, 10, 9])
+def test_cut_falls_back_to_a_word_boundary(cap):
+    assert slugify(FOX, max_length=cap) == "the-quick"
+
+
+def test_cut_never_leaves_a_trailing_hyphen():
+    assert slugify(FOX, max_length=10) == "the-quick"
+
+
+@pytest.mark.parametrize("cap", [19, 100])
+def test_slug_that_already_fits_is_unchanged(cap):
+    assert slugify(FOX, max_length=cap) == "the-quick-brown-fox"
+
+
+def test_first_word_longer_than_the_cap_is_cut_not_dropped():
+    assert slugify("Supercalifragilistic", max_length=5) == "super"
+    assert slugify(FOX, max_length=2) == "th"
+
+
+def test_short_word_before_a_long_one_keeps_only_whole_words():
+    assert slugify("a supercalifragilistic", max_length=10) == "a"
+
+
+def test_empty_slug_stays_empty_with_a_cap():
+    assert slugify("!!!", max_length=5) == ""
+
+
+@pytest.mark.parametrize("cap", [0, -1, -100])
+def test_cap_below_one_is_refused_in_code(cap):
+    with pytest.raises(ValueError, match="max_length must be at least 1"):
+        slugify(FOX, max_length=cap)
+
+
+def test_cap_of_one_is_accepted():
+    assert slugify("Hello, World!", max_length=1) == "h"
+
+
+# --- --max-length on the command line ---------------------------------------
+
+def test_script_without_a_cap_prints_the_whole_slug():
+    finished = run_script(FOX)
+    assert finished.returncode == 0
+    assert finished.stdout == "the-quick-brown-fox\n"
+
+
+def test_script_with_a_cap_prints_the_cut_slug():
+    finished = run_script("--max-length", "12", FOX)
+    assert finished.returncode == 0
+    assert finished.stdout == "the-quick\n"
+
+
+def test_cli_accepts_the_cap_after_the_title_and_with_equals(capsys):
+    assert main([FOX, "--max-length", "12"]) == 0
+    assert main(["--max-length=12", FOX]) == 0
+    assert capsys.readouterr().out == "the-quick\nthe-quick\n"
+
+
+def expect_exit_2(argv, capsys):
+    with pytest.raises(SystemExit) as stopped:
+        main(argv)
+    assert stopped.value.code == 2
+    printed = capsys.readouterr()
+    assert printed.out == ""
+    return printed.err
+
+
+@pytest.mark.parametrize(
+    "bad_cap",
+    [
+        "0",
+        "-3",
+        "abc",
+        "",
+        "1.5",
+        "12abc",
+        "9" * 5000,
+    ],
+)
+def test_cli_refuses_a_bad_cap(bad_cap, capsys):
+    error = expect_exit_2(["--max-length", bad_cap, FOX], capsys)
+    assert "--max-length" in error
+    assert "must be a whole number of at least 1" in error
+
+
+def test_script_refuses_a_bad_cap_with_exit_2():
+    finished = run_script("--max-length", "0", FOX)
+    assert finished.returncode == 2
+    assert finished.stdout == ""
+    assert "--max-length" in finished.stderr
+    assert "must be a whole number of at least 1" in finished.stderr
+
+
+@pytest.mark.parametrize(
+    "argv",
+    [
+        ["--max-length", "12"],
+        [FOX, "--max-length"],
+        ["--max-length"],
+        [],
+    ],
+    ids=["missing-title", "missing-cap-value", "flag-alone", "no-arguments"],
+)
+def test_cli_shows_usage_with_the_flag_when_arguments_are_missing(argv, capsys):
+    error = expect_exit_2(argv, capsys)
+    assert error.startswith("usage: python3 slugify.py")
+    assert "[--max-length N]" in error
+
+
+def test_cli_refuses_the_cap_given_twice(capsys):
+    error = expect_exit_2(["--max-length", "5", "--max-length", "9", FOX], capsys)
+    assert "--max-length" in error
+    assert "only once" in error
+
+
+@pytest.mark.parametrize(
+    "argv",
+    [
+        ["One", "Two"],
+        ["--max", "5", FOX],
+        ["-m", "5", FOX],
+    ],
+    ids=["two-titles", "abbreviated-flag", "short-flag"],
+)
+def test_cli_refuses_extra_or_unknown_arguments(argv, capsys):
+    expect_exit_2(argv, capsys)
+
+
+# --- titles that start with a hyphen ---------------------------------------
+# Only --max-length is an option; every other argument is the title, even
+# one that starts with a hyphen, as before --max-length existed.
+
+@pytest.mark.parametrize(
+    "title, expected",
+    [
+        ("-x", "x"),
+        ("--- Draft ---", "draft"),
+        ("--help", "help"),
+        ("-h", "h"),
+        ("--", ""),
+        ("-", ""),
+        ("--max", "max"),
+        ("-3 Tips", "3-tips"),
+    ],
+)
+def test_cli_prints_the_slug_of_a_title_starting_with_a_hyphen(title, expected, capsys):
+    assert main([title]) == 0
+    assert capsys.readouterr().out == expected + "\n"
+
+
+@pytest.mark.parametrize(
+    "argv",
+    [
+        ["--max-length", "5", "-draft-notes"],
+        ["-draft-notes", "--max-length", "5"],
+        ["--max-length=5", "-draft-notes"],
+    ],
+    ids=["cap-first", "cap-last", "cap-with-equals"],
+)
+def test_cli_caps_a_title_starting_with_a_hyphen(argv, capsys):
+    assert main(argv) == 0
+    assert capsys.readouterr().out == "draft\n"
+
+
+def test_script_prints_the_slug_of_a_title_starting_with_a_hyphen():
+    finished = run_script("--Draft--")
+    assert finished.returncode == 0
+    assert finished.stdout == "draft\n"
+
+
+@pytest.mark.parametrize(
+    "argv",
+    [
+        ["-x", "-y"],
+        ["--", "-x"],
+        ["-x", "--max-length", "5", "-y"],
+    ],
+    ids=["two-hyphen-titles", "separator-and-title", "hyphen-titles-around-cap"],
+)
+def test_cli_refuses_two_titles_even_when_they_start_with_a_hyphen(argv, capsys):
+    expect_exit_2(argv, capsys)
+
+
+# --- a cap written with too many characters --------------------------------------
+# Refused on every Python version, not only where int() limits digit count.
+
+def test_cli_refuses_a_cap_written_with_more_than_twenty_digits(capsys):
+    error = expect_exit_2(["--max-length", "9" * 21, FOX], capsys)
+    assert "--max-length" in error
+    assert "at most 20 characters long" in error
+
+
+def test_cli_accepts_a_cap_written_with_twenty_digits(capsys):
+    assert main(["--max-length", "9" * 20, FOX]) == 0
+    assert capsys.readouterr().out == "the-quick-brown-fox\n"
+
+
+# --- README examples ---------------------------------------------------------
+
+README = Path(__file__).with_name("README.md")
+
+
+def readme_examples():
+    """Each `$ python3 slugify.py ...` line in the README with the line printed after it."""
+    lines = README.read_text(encoding="utf-8").splitlines()
+    examples = []
+    for index, line in enumerate(lines):
+        if line.startswith("$ python3 slugify.py "):
+            arguments = shlex.split(line[len("$ python3 slugify.py "):])
+            examples.append((arguments, lines[index + 1]))
+    return examples
+
+
+def test_readme_has_examples_to_check():
+    assert len(readme_examples()) >= 2
+
+
+@pytest.mark.parametrize("arguments, printed", readme_examples())
+def test_readme_example_prints_what_the_readme_shows(arguments, printed):
+    finished = run_script(*arguments)
+    assert finished.returncode == 0
+    assert finished.stdout == printed + "\n"
